# ----------------------------------------
# Compiled application and packages
# ----------------------------------------
# Go build artifacts (the main executable)
/forum

# Dependency cache
/vendor/

# Binary files for specific operating systems
*.exe
*.dll
*.so
*.dylib

# ----------------------------------------
# OS and Editor Files
# ----------------------------------------
# macOS metadata
.DS_Store

# IDE and editor temporary files
# Example for VS Code
.vscode/

# The development database file
/assets/database/*.db
/assets/database/*.db-*
/src/assets/database/*.db
/src/assets/database/*.db-*

# Local Go cache used for sandboxed test runs
/.gocache/
/src/.gocache/

# Local audit logs
/audit-server*.log
